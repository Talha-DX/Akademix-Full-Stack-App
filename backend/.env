PORT=5000

# --- PostgreSQL ---
# Point this at any standalone Postgres instance:
#   Local install:  postgresql://USER:PASSWORD@localhost:5432/akademix
#   Docker:         postgresql://postgres:postgres@localhost:5432/akademix
#   Managed host (Railway/Neon/RDS/etc.): use the connection string it gives you
DATABASE_URL="postgresql://talha:123456@localhost:5432/akademix"
DIRECT_URL="postgresql://talha:123456@localhost:5432/akademix"

JWT_SECRET="school-management-system"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional — only needed if file uploads go to Cloudinary instead of local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=