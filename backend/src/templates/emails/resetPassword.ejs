<!doctype html>
<html lang="en">
  <body style="font-family:Arial,sans-serif;color:#1f2937;line-height:1.5">
    <h2>Reset your Akademix password</h2>
    <p>Hello <%= name %>,</p>
    <p>We received a request to reset your password. Use the link below to choose a new password. It expires in <%= expiresIn %>.</p>
    <p><a href="<%= resetUrl %>">Reset password</a></p>
    <p>If you did not request this, you can safely ignore this email.</p>
  </body>
</html>
